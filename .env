# CampusCash Deployment Environment Variables
SPRING_PROFILES_ACTIVE=prod
DOMAIN_NAME=localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080

# PostgreSQL Configuration
POSTGRES_DB=campuscash
POSTGRES_USER=campuscash_admin
POSTGRES_PASSWORD=cc_prod_sec_7a8f902b1c4e
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/campuscash

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptographically Strong JWT HMAC-SHA256 Secret (64 hex characters / 256 bits)
APP_JWT_SECRET=f4a7c8e912d3b45a67890123456789abcdef0123456789abcdef0123456789ab
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# Cloud AI Integration (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=GEMINI

# Seed demo student in initial deployment for verification
APP_SEED_DEMO_DATA=true
